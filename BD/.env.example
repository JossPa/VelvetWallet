# =============================================================================
# Variables de entorno para el entorno de BD de Velvet Wallet
# -----------------------------------------------------------------------------
# 1. Copia este archivo a ".env"  ->  cp .env.example .env
# 2. Cambia las contraseñas antes de usarlo fuera de tu equipo local.
# 3. El archivo .env NUNCA se sube al repo (debe estar en .gitignore).
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=velvet
POSTGRES_PASSWORD=cambia_esto_en_local
POSTGRES_DB=velvet_wallet
POSTGRES_PORT=5432

# --- MongoDB ---
MONGO_USER=velvet
MONGO_PASSWORD=cambia_esto_en_local
MONGO_DB=velvet_wallet
MONGO_PORT=27017

# --- Redis ---
REDIS_PORT=6379

# --- Cadenas de conexión (las usará el backend FastAPI más adelante) ---
# DATABASE_URL=postgresql+psycopg://velvet:cambia_esto_en_local@localhost:5432/velvet_wallet
# MONGO_URL=mongodb://velvet:cambia_esto_en_local@localhost:27017/velvet_wallet?authSource=admin
# REDIS_URL=redis://localhost:6379/0
