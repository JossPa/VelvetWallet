# Copia este archivo a ".env"  ->  cp .env.example .env
# El .env real no se sube al repo (lo ignora el .gitignore).

# Proveedor SFA. Hoy el simulador; para un banco real, cambia solo esta URL.
SFA_BASE_URL=http://localhost:8001/accounts/v1

# PostgreSQL (deben calzar con BD/.env)
DATABASE_URL=postgresql://velvet:cambia_esto_en_local@localhost:5432/velvet_wallet

# MongoDB (ojo con authSource=admin)
MONGO_URL=mongodb://velvet:cambia_esto_en_local@localhost:27017/?authSource=admin
MONGO_DB=velvet_wallet

# Identidad de demostración (mientras no exista registro + consentimiento)
USUARIO_EMAIL=demo@velvetwallet.cl
USUARIO_NOMBRE=Usuario Demo
INSTITUCION_NOMBRE=Banco Simulado SFA
